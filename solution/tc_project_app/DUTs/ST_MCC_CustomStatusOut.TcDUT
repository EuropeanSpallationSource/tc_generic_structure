<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <DUT Name="ST_MCC_CustomStatusOut" Id="{6d8ad02a-be6f-0232-209b-380247c69933}">
    <Declaration><![CDATA[//Status information specific to the cabinet IPC --> PNOZ, can be customized depending on cabinet
TYPE ST_MCC_CustomStatusOut :
STRUCT
	//Note: This is just an example, move status bits into tc_mca_std_lib make it a UDINT.
	//Map the bits in specific application code. 
    bReserved16: BIT;
    bReserved17: BIT;
    bReserved18: BIT;
    bReserved19: BIT;
    bFocusDoorLocked: BIT;
    bReserved21: BIT;
    bChangerMovingPos: BIT; //Set if moving in a positive direction
    bChangerMovingNeg: BIT; //Set if moving in a negative direction
    bReserved24: BIT;
    bReserved25: BIT;
    bReserved26: BIT;
    bReserved27: BIT;
    bReserved28: BIT;
    bReserved29: BIT;
    bReserved30: BIT;
    bReserved31: BIT;
END_STRUCT
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>