<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Pneumatic_Box" Id="{6f77a7af-7f82-065a-2434-407aca22087a}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Pneumatic_Box
VAR
    //Define all necessary variables for your application
    bPowerLedAndLight AT %Q*: BOOL:= TRUE; //Variable to power the green LED and the internal light
    bPowerPressureSensors AT %Q*: BOOL:= TRUE; //Variable to power the air pressure sensors in the pneuatmic box

    //{attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^KF201 (EK1200)^KF216 (EL3174-0002)^AI Standard Channel 1^Value'}
    nAirPressureSensorRaw1 AT %I*: INT;

    //{attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^KF201 (EK1200)^KF216 (EL3174-0002)^AI Standard Channel 2^Value'}
    nAirPressureSensorRaw2 AT %I*: INT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[GVL.afbPressureGroup[E_PneumaticAxisGroup.ePneumaticAxisGroup1](
    nAirPressureSensorRaw := nAirPressureSensorRaw1,
    fPressureLimitLow := GVL_APP.fLOW_LIMIT_AIR_PRESSURE1,
    fPressureLimitHigh := GVL_APP.fHIGH_LIMIT_AIR_PRESSURE1,
    tPressureOutOfRange := GVL_APP.tTIME_PRESSURE_OUT_OF_RANGE);

GVL.afbPressureGroup[E_PneumaticAxisGroup.ePneumaticAxisGroup2](
    nAirPressureSensorRaw := nAirPressureSensorRaw2,
    fPressureLimitLow := GVL_APP.fLOW_LIMIT_AIR_PRESSURE2,
    fPressureLimitHigh := GVL_APP.fHIGH_LIMIT_AIR_PRESSURE2,
    tPressureOutOfRange := GVL_APP.tTIME_PRESSURE_OUT_OF_RANGE);
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>