<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Motion_Safety" Id="{2cc620d0-4324-0fec-1587-9760faae60d9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Motion_Safety
VAR
    fbMotionSafety: FB_MotionSafety;
    stSafety: ST_Safety;
    bAxisEnableAllowed: BOOL;
    ftrigAxisEnableAllowed: F_TRIG;

    //Heartbeat
    tHeartbeatElapsed: TIME;
    tMCCWatchdogElapsed: TIME;
    bMCCHeartbeatInOld: BOOL;
    bMCCHeartbeatInit: BOOL;
    bMCCWatchdogFault: BOOL;
    bMCC_OK: BOOL;
    fbSafetyAckLedPulse: FB_PulseGenerator;
END_VAR
VAR CONSTANT
    tPLC_CYCLE_TIME: TIME := T#10MS; //PLC task cycle time
    tHEARTBEAT_PERIOD: TIME := T#200MS; //MCC heartbeat output period
    cHEARTBEAT_PW: LREAL := 50.0; //Heartbeat pulse width percentage
    tMCC_WATCHDOG_TIME: TIME := T#1S; //MCC watchdog timeout
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbMotionSafety(bEnable := TRUE, stSafety := stSafety);

IF NOT fbMotionSafety.bDone THEN
    bMCC_OK := FALSE;
    bAxisEnableAllowed := FALSE;

    mHandleMotionPermission();

    //Reset FB:s when safety data is invalid
    fbSafetyAckLedPulse(bEnable := FALSE);
    RETURN;
END_IF

mMCCStatus(); //Heartbeat generation and MCC watchdog check
mTechnosoftStatus();
mUpdateFaultFeedback();
mHandleMotionPermission();

fbMotionSafety.mWriteOutputs(stSafetyData := stSafety);
]]></ST>
    </Implementation>
    <Method Name="mCheckMCCHeartbeat" Id="{92bf9997-b495-087d-1b0e-cb488d1974e1}">
      <Declaration><![CDATA[METHOD mCheckMCCHeartbeat : BOOL
VAR_INPUT
    bEnable: BOOL;
    bHeartbeatIn: BOOL;
    tTaskCycleTime: TIME;
    tHeartbeatPeriod: TIME;
    fHeartbeatPW: LREAL; //Percent, e.g. 50.0
    tWatchdogTime: TIME;
END_VAR
VAR_OUTPUT
    bHeartbeatOut: BOOL;
    bWatchdogFault: BOOL;
END_VAR
VAR
    tHeartbeatOnTime: TIME;
    fPWClamped: LREAL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Disabled state
IF NOT bEnable THEN
    tHeartbeatElapsed := T#0MS;
    tMCCWatchdogElapsed := T#0MS;
    bMCCHeartbeatInit := FALSE;

    bHeartbeatOut := FALSE;
    bWatchdogFault := FALSE;

    mCheckMCCHeartbeat := FALSE;
    RETURN;
END_IF

//Clamp pulse width percentage
fPWClamped := fHeartbeatPW;
IF fPWClamped < 0.0 THEN
    fPWClamped := 0.0;
ELSIF fPWClamped > 100.0 THEN
    fPWClamped := 100.0;
END_IF

//Convert heartbeat period and pulse width into ON time
tHeartbeatOnTime := LREAL_TO_TIME(TIME_TO_LREAL(tHeartbeatPeriod) * fPWClamped / 100.0);

//Generate heartbeat output
tHeartbeatElapsed := tHeartbeatElapsed + tTaskCycleTime;

IF tHeartbeatElapsed >= tHeartbeatPeriod THEN
    tHeartbeatElapsed := tHeartbeatElapsed - tHeartbeatPeriod;
END_IF

bHeartbeatOut := tHeartbeatElapsed < tHeartbeatOnTime;

//Initialize watchdog memory on first enabled scan
IF NOT bMCCHeartbeatInit THEN
    bMCCHeartbeatInOld := bHeartbeatIn;
    tMCCWatchdogElapsed := T#0MS;
    bMCCHeartbeatInit := TRUE;
END_IF

//Watch incoming heartbeat for any change, rising or falling
IF bHeartbeatIn <> bMCCHeartbeatInOld THEN
    bMCCHeartbeatInOld := bHeartbeatIn;
    tMCCWatchdogElapsed := T#0MS;
ELSE
    IF tMCCWatchdogElapsed < tWatchdogTime THEN
        tMCCWatchdogElapsed := tMCCWatchdogElapsed + tTaskCycleTime;
    END_IF
END_IF

//Watchdog result
bWatchdogFault := tMCCWatchdogElapsed >= tWatchdogTime;

mCheckMCCHeartbeat := NOT bWatchdogFault;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mHandleMotionPermission" Id="{eb3ebf73-f231-0c4c-28cd-6b5568e9d524}">
      <Declaration><![CDATA[METHOD mHandleMotionPermission
VAR
    nAxis: UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[ftrigAxisEnableAllowed(CLK := bAxisEnableAllowed); //Detect falling edge of motion permission

IF ftrigAxisEnableAllowed.Q THEN
    FOR nAxis := 1 TO GVL_APP.nAXIS_NUM DO
        astAxes[nAxis].stControl.bEnable := FALSE; //Disable each axis once
    END_FOR;
END_IF;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mMCCStatus" Id="{b527e3f9-8cb4-05c0-111b-523e1f7c98af}">
      <Declaration><![CDATA[METHOD mMCCStatus
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bMCC_OK := mCheckMCCHeartbeat(
    bEnable := TRUE,
    bHeartbeatIn := stSafety.stSafetyIn.stMCCStatusIn.bit0_Heartbeat,
    tTaskCycleTime := tPLC_CYCLE_TIME,
    tHeartbeatPeriod := tHEARTBEAT_PERIOD,
    fHeartbeatPW := cHEARTBEAT_PW,
    tWatchdogTime := tMCC_WATCHDOG_TIME,
    bHeartbeatOut => stSafety.stSafetyOut.stMCCStatusOut.bit0_Heartbeat,
    bWatchdogFault => bMCCWatchdogFault
);

bAxisEnableAllowed :=
    stSafety.stSafetyIn.stMCCStatusIn.bit1_EStopOK
    AND bMCC_OK;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mTechnosoftErrorActive" Id="{e4a5f594-242e-09c2-08fb-1485b2fa8c17}">
      <Declaration><![CDATA[METHOD mTechnosoftErrorActive : BOOL
VAR_INPUT
     stError: ST_TechnosoftMotionError;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[mTechnosoftErrorActive :=
    stError.bit0_EtherCATCommunicationError
    OR stError.bit1_ShortCircuit
    OR stError.bit2_InvalidSetupData
    OR stError.bit3_ControlError
    OR stError.bit4_CommunicationError
    OR stError.bit5_FeedbackError
    OR stError.bit6_PositiveLimitSwitchActive
    OR stError.bit7_NegativeLimitSwitchActive
    OR stError.bit8_OverCurrent
    OR stError.bit9_I2TProtection
    OR stError.bit10_MotorOverTemperature
    OR stError.bit11_DriveOverTemperature
    OR stError.bit12_OverVoltage
    OR stError.bit13_UnderVoltage
    OR stError.bit14_CommandError;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mTechnosoftStatus" Id="{3ce40432-5709-0331-322c-9828a759ac7e}">
      <Declaration><![CDATA[METHOD mTechnosoftStatus : BOOL
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mUpdateFaultFeedback" Id="{ab8c657f-8288-0e3c-2f14-a6b67c9c93ad}">
      <Declaration><![CDATA[METHOD mUpdateFaultFeedback

]]></Declaration>
      <Implementation>
        <ST><![CDATA[stSafety.stSafetyOut.stMCCStatusOut.bit3_ErrAck :=
    stSafety.stSafetyIn.stMCCStatusIn.bit3_Fault;

fbSafetyAckLedPulse(
    bEnable := stSafety.stSafetyIn.stMCCStatusIn.bit3_Fault,
    tFlashPeriod := T#1S,
    tOffTime := T#500MS,
    tOnTime := T#500MS,
    nFlashCount := 1,
    bOut => GVL_SafetyIO.bSafetyAcknowledgeLED);
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>