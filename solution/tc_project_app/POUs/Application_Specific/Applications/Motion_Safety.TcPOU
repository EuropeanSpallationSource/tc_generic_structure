<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Motion_Safety" Id="{2cc620d0-4324-0fec-1587-9760faae60d9}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Motion_Safety
VAR
    fbMotionSafety: FB_MotionSafety;
    stSafety: ST_Safety;
    bMCC_OK: BOOL;
    bMotionEnableAllowed: BOOL;
    bMCCWatchdogFault: BOOL;
    bInit: BOOL;
	
	
    //Add specific motion safety application below
    fbCaveFlashLED: FB_PulseGenerator;

	//A safe output group is related to specific contactors QA60X..QA60X+N controlling (MX..MX+N/PX..PX+N)
	//According to EPLAN (see Safety Output Zones)
    astSafetyOutputGroups: ARRAY[1..GVL_APP.nNUM_OF_SAFETY_OUTPUT_GROUPS] OF ST_SafetyOutputGroups := [
    (*SO1*) (nMotorAxisCount := 6, nPneumaticAxisCount := 0, anMotorAxisID := [1, 2, 3, 4]),
    (*SO2*) (nMotorAxisCount := 1, nPneumaticAxisCount := 0, anMotorAxisID := [5]),
    (*SO3*) (nMotorAxisCount := 0, nPneumaticAxisCount := 0),
    (*SO4*) (nMotorAxisCount := 0, nPneumaticAxisCount := 2, anPneumaticAxisID := [5, 6])
	];
	
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[fbMotionSafety(
    bEnable := TRUE,
    stSafety := stSafety,
    bMCC_OK => bMCC_OK,
    bMotionEnableAllowed => bMotionEnableAllowed,
    bMCCWatchdogFault => bMCCWatchdogFault);


 //Add specific motion safety application below
mInit(); //Placeholder, string name of diagnostic elements, specific for each instrument
mSafetyZoneLED(); //Placeholder, LED specific to safety zone = E-Stop Loop
mLocalMotionPermission(); //Placeholder, related to general pendant logic in local mode (OP-Stop, Jog Buttons etc.)

fbMotionSafety.mWriteOutputs(stSafetyOut := stSafety.stOut);
]]></ST>
    </Implementation>
    <Method Name="mInit" Id="{280b85c8-9dab-069e-37fb-2898aabfbce3}">
      <Declaration><![CDATA[METHOD mInit
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT bInit THEN
    RETURN;
END_IF

(*Fill in specific diagnostic elements, specific for each instrument.
stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eEStop].sName := 'SFunc01 EStop';
stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eOPStop].sName := 'SFunc02 OpStop';
stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eOPEnable].sName := 'SFunc03 OpEnable';

stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eIN2Door].sName := 'IN2 Door';
stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eIN3OpStop].sName := 'IN3 OpStop';
stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eIN4OpEn].sName := 'IN4 OpEn';
stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eIN5EStop].sName := 'IN5 EStop';
stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eIN6PStop].sName := 'IN6 PStop';
stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eIN7Degraded].sName := 'IN7 Degraded';

stSafety.stOut.astDiagnosticElement[E_DiagnosticElements.eEnTimerPendant].sName := 'EnTimer Pendant';
*)
bInit := FALSE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="mLocalMotionPermission" Id="{dac061d6-7611-0b60-26a1-6d091f2bdb9b}">
      <Declaration><![CDATA[METHOD mLocalMotionPermission
VAR
    nGroup: UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[//Default groups to global permission
//FOR nGroup := 1 TO GVL_APP.nNUM_OF_SAFETY_OUTPUT_GROUPS DO
//    astSafetyOutputGroups[nGroup].bEnableSO := bMotionEnableAllowed;
//END_FOR


////Note: This is just an example, here specific application code will be written to set the bEnableSO 
////for each output group
////Application-specific permissions
//astSafetyOutputGroups[1].bEnableSO :=
//    bMotionEnableAllowed
//    AND NOT stSafety.stIn.stMCCStatus.bRemote
//    AND NOT stSafety.stIn.astDiagnosticElement[E_DiagnosticElements.eOPEnable].bSafe;

//astSafetyOutputGroups[4].bEnableSO :=
//    bMotionEnableAllowed
//    AND NOT stSafety.stIn.stMCCStatus.bRemote
//    AND NOT stSafety.stIn.astDiagnosticElement[E_DiagnosticElements.eOPEnable].bSafe;

//Add other application-specific group conditions here]]></ST>
      </Implementation>
    </Method>
    <Method Name="mSafetyZoneLED" Id="{d293da0b-0bcb-011e-006d-6ae3bcdda101}">
      <Declaration><![CDATA[METHOD mSafetyZoneLED
]]></Declaration>
      <Implementation>
        <ST><![CDATA[(*
IF NOT bMCC_OK THEN
    fbCaveFlashLED(
        bEnable := TRUE,
        tFlashPeriod := T#1000MS,
        tOffTime := T#100MS,
        tOnTime := T#100MS,
        nFlashCount := 3,
        bOut => GVL_Safety.bCaveLED);
ELSIF stSafety.stIn.stMCCStatus.bRemote THEN
    GVL_Safety.bCaveLED := FALSE;
ELSE
    fbCaveFlashLED(bEnable := FALSE);
    GVL_Safety.bCaveLED := TRUE;
END_IF
*)
]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>