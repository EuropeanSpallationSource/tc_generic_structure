<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Pneumatics_Template" Id="{7bf401fb-a600-4741-a67b-36f20e194cfc}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Pneumatics_Template
VAR
    //Define all necessary variables for your application
    //{attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^KF201 (EK1200)^KF209 (EL2014)^DIG Outputs^Channel 1^Output'}
    bEndSwitchesPowerON AT %Q*: BOOL := TRUE; //Power output for pneumatic axis end switches
END_VAR
VAR CONSTANT
    cAXIS_ID: USINT := 1;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Initial parameters of an Pneumatic Axis
//Uncomment the next IF statement to configure and activate the intial parameters of the axis
(*
IF _TaskInfo[fbGetCurTaskIndex.index].FirstCycle THEN
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.sPneumaticAxisName := 'P1PneuAxis';
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.bSafetyShutter := FALSE;
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.nTimeLimitMovingWithValveOff := 10;
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.nTimeLimitMovingWithValveOn := 10;
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.eSelectPneumaticAxisGroup := E_PneumaticAxisGroup.ePneumaticAxisGroup1;
END_IF
*)
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>