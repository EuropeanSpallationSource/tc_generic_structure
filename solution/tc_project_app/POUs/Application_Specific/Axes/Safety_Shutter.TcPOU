<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <POU Name="Safety_Shutter" Id="{6edcef4b-0039-01e0-14cb-28763a1c98aa}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM Safety_Shutter
VAR
    //Define all necessary variables for your application
    //{attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^KF201 (EK1200)^KF209 (EL2014)^DIG Outputs^Channel 3^Output'}
    bPSSPermitPower AT %Q*: BOOL := TRUE;
    //{attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^KF201 (EK1200)^KF208 (EL1808)^Channel 5^Input'}
    bPSSPermit1 AT %I*: BOOL;
    //{attribute 'TcLinkTo' := 'TIID^Device 1 (EtherCAT)^KF201 (EK1200)^KF208 (EL1808)^Channel 6^Input'}
    bPSSPermit2 at %I*: BOOL;
END_VAR
VAR CONSTANT
    cAXIS_ID: USINT := 1;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[//Initial parameters of an Pneumatic Axis
//Uncomment the next IF statement to configure and activate the intial parameters of the axis
(*
IF _TaskInfo[fbGetCurTaskIndex.index].FirstCycle THEN
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.sPneumaticAxisName := 'SafetyShutter';
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.bSafetyShutter := TRUE;
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.nTimeLimitMovingWithValveOff := 10;
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.nTimeLimitMovingWithValveOn := 10;
    GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisConfig.eSelectPneumaticAxisGroup := E_PneumaticAxisGroup.ePneumaticAxisGroup1;
END_IF

//PSS Permit signal
GVL.astPneumaticAxes[cAXIS_ID].stPneumaticAxisInputs.bPSSPermitOK := bPSSPermit1 AND bPSSPermit2
*)
]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>